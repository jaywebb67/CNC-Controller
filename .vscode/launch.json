{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch build\\app.exe",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\app.exe",
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "preLaunchTask": "Build app (ucrt64 g++)",
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing" }
      ]
    }
  ]
}
